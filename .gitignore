# root git ignore
*.pyc
__pycache__/
.env
*.env.local
.DS_Store
node_modules/
**/.svelte-kit/
**/dist/
**/build/
**/.coverage
**/coverage/
**/*.egg-info/
**/*.log

# Ignore runtime subfolders (test models, checkpoints, etc.)
/api/runtime/*/
# Allow production models and db in runtime root
!/api/runtime/*.zip
!/api/runtime/rbgg.db
/api/.gitignore