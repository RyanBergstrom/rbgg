{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run API (uvicorn)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "uvicorn", "app:app", "--reload", "--port", "8000"],
            "options": {
                "cwd": "${workspaceFolder}/api",
                "env": {
                    "RBGG_DEV": "true"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pytest", "-v"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
